#include<iostream>
using namespace std;

class PhanSo{
private:
    int tuSo, mauSo;
    int timUCLN(int a, int b) {
        a = abs(a);
        b = abs(b);
        while (b != 0) {
            int temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    }

public:
    // --- CÂU 1 ---
    // ham tao khong doi 
    PhanSo() {
        tuSo = 0;
        mauSo = 1;
    }

    // Ham tao co doi 
    PhanSo(int tu, int mau) {
        tuSo = tu;
        mauSo = (mau == 0) ? 1 : mau;
        rutGon();
    }

    // Ham huy 
    ~PhanSo() {}

    // --- CÂU 2 ---
    // Phuong thuc rut gon 
    void rutGon() {
        if (mauSo == 0) return;
        int ucln = timUCLN(tuSo, mauSo);
        tuSo /= ucln;
        mauSo /= ucln;
        if (mauSo < 0) {
            tuSo = -tuSo;
            mauSo = -mauSo;
        }
    }

    // Phuong thuc nhap 
    void nhap() {
        cout << "  Nhap tu so: ";
        cin >> tuSo;
        do {
            cout << "  Nhap mau so (khac 0): ";
            cin >> mauSo;
            if (mauSo == 0) {
                cout << "  Mau so phai khac 0. Nhap lai!\n";
            }
        } while (mauSo == 0);
        rutGon();
    }

    // phuong thuc xuat 
	    void xuat() const {
        if (mauSo == 1) cout << tuSo;
        else if (tuSo == 0) cout << 0;
        else cout << tuSo << "/" << mauSo;
    }

    // Phuong thuc cong 
    PhanSo cong(const PhanSo& ps) const {
        PhanSo kq;
        kq.tuSo = this->tuSo * ps.mauSo + ps.tuSo * this->mauSo;
        kq.mauSo = this->mauSo * ps.mauSo;
        kq.rutGon();
        return kq;
    }

    // Phuong thuc tru 
    PhanSo tru(const PhanSo& ps) const {
        PhanSo kq;
        kq.tuSo = this->tuSo * ps.mauSo - ps.tuSo * this->mauSo;
        kq.mauSo = this->mauSo * ps.mauSo;
        kq.rutGon();
        return kq;
    }

    // Phuong thuc nhan 
    PhanSo nhan(const PhanSo& ps) const {
        PhanSo kq;
        kq.tuSo = this->tuSo * ps.tuSo;
        kq.mauSo = this->mauSo * ps.mauSo;
        kq.rutGon();
        return kq;
    }

    // Phuong thuc chia 
    PhanSo chia(const PhanSo& ps) const {
        PhanSo kq;
        if (ps.tuSo == 0) {
            cout << "\n[Loi] Khong the chia cho 0!";
            return kq;
        }
        kq.tuSo = this->tuSo * ps.mauSo;
        kq.mauSo = this->mauSo * ps.tuSo;
        kq.rutGon();
        return kq;
    }
};

int main()
{
    // --- CÂU 3 ---
    PhanSo ps1, ps2;

    cout << "=== NHAP PHAN SO 1 ===\n";
    ps1.nhap();

    cout << "\n=== NHAP PHAN SO 2 ===\n";
    ps2.nhap();

    cout << "\n-------------------------------\n";
    cout << "Phan so 1 (toi gian): "; ps1.xuat(); cout << endl;
    cout << "Phan so 2 (toi gian): "; ps2.xuat(); cout << endl;
    cout << "-------------------------------\n";

    // thuc hien cong tru nhan chia 
    PhanSo tong   = ps1.cong(ps2);
    PhanSo hieu   = ps1.tru(ps2);
    PhanSo tich   = ps1.nhan(ps2);
    PhanSo thuong = ps1.chia(ps2);

    // In ket qua  
    cout << "\n=== KET QUA ===\n";
    cout << "Tong  : "; ps1.xuat(); cout << " + "; ps2.xuat(); cout << " = "; tong.xuat();   cout << endl;
    cout << "Hieu  : "; ps1.xuat(); cout << " - "; ps2.xuat(); cout << " = "; hieu.xuat();   cout << endl;
    cout << "Tich  : "; ps1.xuat(); cout << " * "; ps2.xuat(); cout << " = "; tich.xuat();   cout << endl;
    cout << "Thuong: "; ps1.xuat(); cout << " : "; ps2.xuat(); cout << " = "; thuong.xuat(); cout << endl;

    return 0;
}
// bài 2
#include <iostream>
using namespace std;

class PhanSo
{
private:
    int tuSo;
    int mauSo;

public:
    // ham tao khong doi
    PhanSo()
    {
        tuSo = 0;
        mauSo = 1;
    }

    // Ham tao co doi
    PhanSo(int tu, int mau)
    {
        tuSo = tu;
        mauSo = mau;
    }

    // Ham huy
    ~PhanSo()
    {
    }
    void rutGon()
    {
        int a = tuSo;
        int b = mauSo;

        // Tìm UCLN
        while (b != 0)
        {
            int r = a % b;
            a = b;
            b = r;
        }

        tuSo = tuSo / a;
        mauSo = mauSo / a;
        if (mauSo < 0)
        {
            tuSo = -tuSo;
            mauSo = -mauSo;
        }
    }
    friend istream& operator >> (istream& in, PhanSo& p)
    {
        cout << "Nhap tu so: ";
        in >> p.tuSo;

        cout << "Nhap mau so: ";
        in >> p.mauSo;

        return in;
    }
    friend ostream& operator << (ostream& out, PhanSo p)
    {
        out << p.tuSo << "/" << p.mauSo;
        return out;
    PhanSo operator + (PhanSo p)
    {
        PhanSo kq;

        kq.tuSo = tuSo * p.mauSo + p.tuSo * mauSo;
        kq.mauSo = mauSo * p.mauSo;

        kq.rutGon();

        return kq;
    }
    PhanSo operator - (PhanSo p)
    {
        PhanSo kq;

        kq.tuSo = tuSo * p.mauSo - p.tuSo * mauSo;
        kq.mauSo = mauSo * p.mauSo;

        kq.rutGon();

        return kq;
    }
  
    PhanSo operator * (PhanSo p)
    {
        PhanSo kq;

        kq.tuSo = tuSo * p.tuSo;
        kq.mauSo = mauSo * p.mauSo;

        kq.rutGon();

        return kq;
    }
    PhanSo operator / (PhanSo p)
    {
        PhanSo kq;

        kq.tuSo = tuSo * p.mauSo;
        kq.mauSo = mauSo * p.tuSo;

        kq.rutGon();

        return kq;
    }
};

int main()
{
    PhanSo a, b;
    cout << "Nhap phan so a:\n";
    cin >> a;

    cout << "\nNhap phan so b:\n";
    cin >> b;
    a.rutGon();
    b.rutGon();

    cout << "\nPhan so a = " << a;
    cout << "\nPhan so b = " << b;

    
    cout << "\n\nTong a + b = " << a + b;
    cout << "\nHieu a - b = " << a - b;
    cout << "\nTich a * b = " << a * b;
    cout << "\nThuong a / b = " << a / b;

    return 0;
}
